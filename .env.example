# =============================================================
# polyglot-db-mcp-server .env.example
# Copy this file to .env and adjust values for your environment.
# Do not commit .env files with real credentials.
# =============================================================

# ---- Minimal local SQLite setup ----
# This is the safest 5-minute local configuration because it does not require
# any external database service.
DB_MCP_CONNECTIONS=[{"id":"local","engine":"sqlite","url":"file:./data/local.db","readonly":false}]
DB_MCP_DEFAULT_CONNECTION_ID=local

# ---- Optional multi-engine example ----
# Keep this as one JSON line when copying into .env.
# Replace every placeholder before use. Prefer readonly:true unless writes are required.
# DB_MCP_CONNECTIONS=[{"id":"pg","engine":"postgres","url":"postgres://<pg_user>:<pg_password>@127.0.0.1:5432/<pg_database>","readonly":true},{"id":"mysql","engine":"mysql","host":"127.0.0.1","port":3306,"user":"<mysql_user>","password":"<mysql_password>","database":"<mysql_database>","readonly":true},{"id":"mssql","engine":"mssql","host":"127.0.0.1","port":1433,"user":"<mssql_user>","password":"<mssql_password>","database":"<mssql_database>","readonly":true},{"id":"oracle","engine":"oracle","host":"127.0.0.1","port":1521,"user":"<oracle_user>","password":"<oracle_password>","database":"<oracle_service>","readonly":true},{"id":"mongo","engine":"mongodb","url":"mongodb://<mongo_user>:<mongo_password>@127.0.0.1:27017/?authSource=admin","database":"<mongo_database>","readonly":true,"allowlist":["users","orders"]},{"id":"redis","engine":"redis","url":"redis://:<redis_password>@127.0.0.1:6379/0","readonly":false,"keyPrefix":"app:"},{"id":"local","engine":"sqlite","url":"file:./data/local.db","readonly":false},{"id":"duck","engine":"duckdb","url":":memory:","readonly":true,"allowlist":["./data"]}]
# DB_MCP_DEFAULT_CONNECTION_ID=local

# ---- Query limits ----
DB_QUERY_TIMEOUT=30000
# MongoDB server-side maxTimeMS for find/aggregate/count. 0 disables it.
DB_MONGO_MAX_TIME_MS=30000
# SQL/Mongo row cap and Redis legacy collection/range cap. Valid range: 1..10000.
DB_MAX_ROWS=100
# Serialized MCP tool result cap. Valid range: 4096..16777216; default 1 MiB.
DB_MAX_RESPONSE_BYTES=1048576
DB_MAX_SQL_LENGTH=102400
DB_RETRY_COUNT=2
DB_RETRY_DELAY_MS=200
DB_AUTO_PAGINATION=true

# ---- Cache and rate limiting ----
DB_QUERY_CACHE_SIZE=0
DB_QUERY_CACHE_TTL_MS=30000
DB_RATE_LIMIT_PER_SECOND=0

# ---- Masking and audit ----
# Modes: off, loose, strict, strict-v2
DB_MASKING_MODE=off
DB_MASKING_EXCLUDE_FIELDS=
DB_MASKING_EXCLUDE_CONNECTIONS=
# Audit sinks: memory, file, webhook. File sink writes JSONL.
DB_AUDIT_SINK=memory
DB_AUDIT_FILE_PATH=./logs/audit.jsonl
DB_AUDIT_WEBHOOK_URL=
DB_AUDIT_WEBHOOK_SECRET=
DB_AUDIT_WEBHOOK_TIMEOUT_MS=3000
# Legacy alias for DB_AUDIT_FILE_PATH when DB_AUDIT_SINK is not set.
MCP_AUDIT_LOG=

# ---- Replay, suggestions, and slow query threshold ----
DB_REPLAY_BUFFER_SIZE=50
DB_SUGGEST_TIMEOUT_MS=5000
DB_SLOW_QUERY_MS=5000

# ---- Alert webhook ----
# Explicitly enable to avoid accidental calls from shared shell environments.
DB_ALERT_ENABLED=false
DB_ALERT_WEBHOOK_URL=
DB_ALERT_WEBHOOK_SECRET=
DB_ALERT_MIN_SEVERITY=warning
DB_ALERT_TIMEOUT_MS=3000
DB_ALERT_COOLDOWN_MS=60000
DB_ALERT_TOOL_ERROR_RATE_MIN_CALLS=5
DB_ALERT_TOOL_ERROR_RATE_THRESHOLD=50
# 0 disables slow tool alerts; default follows DB_SLOW_QUERY_MS when unset.
DB_ALERT_SLOW_TOOL_MS=5000

# ---- OpenTelemetry traces ----
# Explicitly enable to register a local tracer provider and exporter.
DB_OTEL_ENABLED=false
# Exporters: otlp_http, console, none
DB_OTEL_EXPORTER=otlp_http
DB_OTEL_SERVICE_NAME=polyglot-db-mcp-server
DB_OTEL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Comma-separated key=value pairs; values are not printed in safe diagnostics.
DB_OTEL_OTLP_HEADERS=
DB_OTEL_SAMPLING_RATIO=1
DB_OTEL_BATCH=true
DB_OTEL_EXPORT_INTERVAL_MS=5000
DB_OTEL_EXPORT_TIMEOUT_MS=30000
DB_OTEL_MAX_QUEUE_SIZE=2048
DB_OTEL_MAX_EXPORT_BATCH_SIZE=512
DB_OTEL_RESOURCE_ATTRIBUTES=

# ---- Redis safety ----
REDIS_BLOCKED_COMMANDS=FLUSHALL,FLUSHDB

# ---- MSSQL connection options ----
DB_MSSQL_ENCRYPT=true
DB_MSSQL_TRUST_SERVER_CERTIFICATE=false

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=human

# ---- Transport ----
# Default remains stdio for desktop MCP clients.
DB_MCP_TRANSPORT=stdio
# Set DB_MCP_TRANSPORT=http to enable Streamable HTTP.
DB_HTTP_HOST=127.0.0.1
DB_HTTP_PORT=3000
DB_HTTP_ENDPOINT=/mcp
# Comma-separated hostnames only; localhost, 127.0.0.1, and ::1 are always allowed.
# Add the public/internal hostname explicitly when binding to 0.0.0.0.
DB_HTTP_ALLOWED_HOSTS=
DB_HTTP_ORIGINS=

# ---- HTTP authentication and RBAC ----
# stdio defaults to DB_AUTH_MODE=none. HTTP defaults to bearer unless disabled.
# Use DB_AUTH_DISABLED=true only for local development.
DB_AUTH_MODE=none
DB_AUTH_ISSUER=
DB_AUTH_AUDIENCE=polyglot-db-mcp-server
DB_AUTH_JWKS_URL=
DB_AUTH_JWKS_FILE=
DB_RBAC_POLICY_FILE=
# Built-in templates: readonly-http, local-admin, diagnostic-readonly.
# DB_RBAC_POLICY_FILE takes precedence when both are set.
DB_RBAC_POLICY_TEMPLATE=
DB_RBAC_DEFAULT_EFFECT=deny
# API key fallback is for development/migration only.
DB_HTTP_API_KEY=
DB_AUTH_DISABLED=false
DB_HTTP_AUTH_DISABLED=false
DB_HTTP_BODY_LIMIT_BYTES=1048576
DB_HTTP_REQUEST_TIMEOUT_MS=30000
# Stateful Streamable HTTP session and resumability limits.
DB_HTTP_MAX_SESSIONS=1000
DB_HTTP_SESSION_IDLE_TIMEOUT_MS=1800000
DB_HTTP_EVENT_STORE_MAX_EVENTS=1000
DB_HTTP_EVENT_STORE_MAX_BYTES=8388608

# ---- Plugin discovery ----
# v3 manifest-first plugins. Empty means disabled.
DB_PLUGIN_PATHS=

# ---- Shutdown and transaction cleanup ----
DB_TRANSACTION_TIMEOUT_MS=300000
DB_MONGO_TRANSACTION_TIMEOUT_MS=300000
DB_SHUTDOWN_TIMEOUT_MS=10000
