{
  "name": "@yclenove/polyglot-db-mcp-server",
  "version": "2.2.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "polyglot-db-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README_en.md",
    ".env.example",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "MIGRATION.md",
    "scripts/healthcheck.mjs",
    "scripts/http-smoke.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node --test --test-name-pattern=. test/*.test.mjs test/auth/*.test.mjs test/drivers/*.test.mjs test/tools/*.test.mjs test/transports/*.test.mjs",
    "test:unit": "node --test --test-name-pattern=. test/*.test.mjs test/auth/*.test.mjs test/tools/*.test.mjs test/transports/*.test.mjs",
    "test:integration": "node --test --test-name-pattern=. test/integration/*.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=json --reporter=lcov node --test --test-name-pattern=. test/*.test.mjs test/auth/*.test.mjs test/drivers/*.test.mjs test/tools/*.test.mjs test/transports/*.test.mjs",
    "test:coverage:check": "c8 --lines 50 --branches 50 --functions 50 node --test --test-name-pattern=. test/*.test.mjs test/auth/*.test.mjs test/drivers/*.test.mjs test/tools/*.test.mjs test/transports/*.test.mjs",
    "benchmark": "node test/benchmark/sql-guards.bench.mjs",
    "docs": "node scripts/generate-docs.mjs"
  },
  "keywords": [
    "mcp",
    "database",
    "mysql",
    "postgresql",
    "sqlserver",
    "oracle",
    "mongodb",
    "redis",
    "duckdb",
    "model-context-protocol"
  ],
  "author": "yclenove",
  "license": "MIT",
  "description": "Multi-engine database MCP server (MySQL, PostgreSQL, SQL Server, Oracle, MongoDB, Redis, SQLite, DuckDB)",
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "mongodb": "^6.12.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.21.0",
    "pg": "^8.13.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "oracledb": "^6.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.9.3"
  }
}
